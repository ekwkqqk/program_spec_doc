PORT=3001
# 로컬 경로 허용 루트 (세미콜론으로 복수 지정, Windows 예: C:\Users;D:\work)
ALLOWED_ROOTS=C:/
# OpenAI 호환 API (미설정 시 규칙 기반 초안 생성)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Git 비공개 저장소용 (선택) — URL에 토큰을 넣지 않고 환경변수로 주입
GIT_TOKEN=
# 분석 상한
MAX_FILES=5000
MAX_TOTAL_BYTES=209715200
CLONE_TIMEOUT_MS=120000
AI_TIMEOUT_MS=180000
